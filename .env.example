# ===== MQTT =====

# Broker credentials (REQUIRED, must match mosquitto/config/passwd)
MQTT_USERNAME=ingestor
MQTT_PASSWORD=changeme

# Optional. "mosquitto" = the broker from docker-compose;
# use "localhost" when running the ingestor outside Docker.
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=meshcore
# Shared subscription group (replicas with the same group share the load)
# MQTT_CONSUMER_GROUP=ingestor-group

# ===== SINKS =====

# Sinks that receive events (comma-separated): telegram, potato (REQUIRED)
SINKS=telegram

# ===== REQUIRED when SINKS includes telegram =====
# Create a bot with @BotFather, add it to the chat/channel, get the chat id (e.g. -1001234567890)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===== REQUIRED when SINKS includes potato =====
# POTATO_HOST=https://your-potato-mesh-instance.example.com
# POTATO_API_TOKEN=your-api-token-here
# Unique name of this ingestor in potato-mesh (sent with every payload)
# POTATO_INGESTOR_NAME=mqtt-ingestor-1

# ===== OPTIONAL =====

# Public channel names to decrypt/forward (without #), e.g. "test,news,general".
# Keys are derived automatically from names. Empty = all public channels.
CHANNELS_RAW=

# telegram: channel names to forward; empty = all decrypted channels
TELEGRAM_CHANNELS_RAW=
# telegram: message template (Telegram HTML), use \n for line breaks. Placeholders:
# {channel} {sender} {text} {repeater} {snr} {rssi} {freq} {preset} {time} {from_id}
# Lines whose placeholders are all empty are dropped. Default:
# TELEGRAM_FORMAT=👤 {sender} ({from_id})\n📡 {channel}\n📶 Signal: SNR: {snr}dB / RSSI: {rssi}dBm\n\n💬 Text: {text}

# potato: repeater node ID (e.g. !3c15e67e) for heartbeat before the first status arrives.
# Learned automatically from status messages.
# REPEATER_NODE_ID=

LOG_LEVEL=INFO
