# MQTT Broker
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=ingestor
MQTT_PASSWORD=changeme
MQTT_TOPIC_PREFIX=meshcore

# Sinks that receive events (comma-separated): potato, telegram
SINKS=potato

# potato sink (required when SINKS includes potato)
POTATO_HOST=https://your-potato-mesh-instance.example.com
POTATO_API_TOKEN=your-api-token-here
INGESTOR_NAME=mqtt-ingestor-1

# telegram sink (required when SINKS includes telegram)
# Create a bot with @BotFather, add it to the chat/channel, get the chat id (e.g. -1001234567890)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Comma-separated channel names to forward; empty = all decrypted channels
TELEGRAM_CHANNELS_RAW=
# Message template (Telegram HTML), use \n for line breaks. Placeholders:
# {channel} {sender} {text} {repeater} {snr} {rssi} {freq} {preset} {time} {from_id}
# Lines whose placeholders are all empty are dropped. Default:
# TELEGRAM_FORMAT=<b>#{channel}</b> · {sender}\n{text}\n<i>{repeater} · SNR {snr} · RSSI {rssi}</i>

# Optional: pre-configure the repeater's canonical node ID (e.g. !3c15e67e)
# Learned automatically from status messages; set this for faster heartbeat startup.
REPEATER_NODE_ID=

# Channel filtering and decryption
# Comma-separated public channel names (without #), e.g. "test,news,general".
# Keys are derived automatically from the name — no manual key needed.
# Empty = forward all public channels (decrypt where possible).
CHANNELS_RAW=

# Scaling
INGESTOR_REPLICAS=1

# Logging
LOG_LEVEL=INFO
